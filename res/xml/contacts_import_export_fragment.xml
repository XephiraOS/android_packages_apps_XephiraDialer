        <com.coui.appcompat.preference.COUIJumpPreference android:key="pref_key_export_to_sim_2" />
    </com.coui.appcompat.preference.COUIPreferenceCategory>
    <com.coui.appcompat.preference.COUIPreferenceCategory android:title="@string/send_contacts" android:key="pref_key_share_contacts">
        <com.android.contacts.framework.baseui.highlight.HighlightJumpPreference android:layout="@layout/coui_preference" android:title="@string/send_contacts" android:key="share_contacts" />
    </com.coui.appcompat.preference.COUIPreferenceCategory>
