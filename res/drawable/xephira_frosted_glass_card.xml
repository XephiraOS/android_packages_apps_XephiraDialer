<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Ambient Crimson Reflection Glow -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <solid android:color="#15E9012A" />
        </shape>
    </item>

    <!-- Translucent Frosted White Acrylic Card Plate -->
    <item android:inset="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="27dp" />
            <gradient
                android:angle="270"
                android:startColor="#F8FFFFFF"
                android:centerColor="#EDF4F6F9"
                android:endColor="#DFECF0F5"
                android:type="linear" />
            <stroke
                android:width="1.5dp"
                android:color="#FFFFFFFF" />
        </shape>
    </item>
</layer-list>
