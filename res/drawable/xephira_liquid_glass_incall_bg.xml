<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Deep Obsidian Frosted Glass Base -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#FF0B0E17"
                android:centerColor="#FF121624"
                android:endColor="#FF080A10"
                android:type="linear" />
        </shape>
    </item>

    <!-- Bottom Liquid Crimson Ambient Aurora -->
    <item
        android:top="300dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#3DE9012A"
                android:endColor="#00000000"
                android:type="linear" />
        </shape>
    </item>

    <!-- Top Ambient Specular Light Horizon -->
    <item
        android:top="0dp"
        android:bottom="400dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#15FFFFFF"
                android:endColor="#00000000"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
