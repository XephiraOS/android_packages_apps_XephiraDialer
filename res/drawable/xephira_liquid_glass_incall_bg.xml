<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pure White Frosted Acrylic In-Call Canvas -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#FFF9FAFB"
                android:centerColor="#FFF2F4F7"
                android:endColor="#FFE8EBEE"
                android:type="linear" />
        </shape>
    </item>

    <!-- Top-Right Ambient Crimson Aurora Bleed -->
    <item
        android:left="200dp"
        android:top="0dp"
        android:bottom="380dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="45"
                android:startColor="#00000000"
                android:endColor="#32E9012A"
                android:type="linear" />
        </shape>
    </item>

    <!-- Bottom-Left Ambient Crimson Aurora Bleed -->
    <item
        android:right="180dp"
        android:top="400dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="225"
                android:startColor="#00000000"
                android:endColor="#35E9012A"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
