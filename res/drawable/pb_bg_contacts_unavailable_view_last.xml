<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <color android:color="@color/coui_list_selector_color_disabled" />
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/coui_color_container8" />
            <corners android:bottomLeftRadius="@dimen/coui_preference_card_radius" android:bottomRightRadius="@dimen/coui_preference_card_radius" />
        </shape>
    </item>
    <item>
        <color android:color="@null" />
    </item>
</selector>