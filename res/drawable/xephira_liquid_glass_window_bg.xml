<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pure White Frosted Acrylic Canvas -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#FFF8F9FA"
                android:centerColor="#FFF1F3F6"
                android:endColor="#FFEAECEF"
                android:type="linear" />
        </shape>
    </item>

    <!-- Ambient Crimson Aurora Glow (Right Margin) -->
    <item
        android:left="180dp"
        android:top="100dp"
        android:bottom="100dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#00000000"
                android:endColor="#28E9012A"
                android:type="linear" />
        </shape>
    </item>

    <!-- Ambient Crimson Aurora Glow (Bottom Margin) -->
    <item
        android:top="500dp"
        android:left="50dp"
        android:right="50dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#00000000"
                android:endColor="#25E9012A"
                android:type="linear" />
        </shape>
    </item>

    <!-- Top Specular Glass Horizon -->
    <item
        android:top="0dp"
        android:bottom="550dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#40FFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
