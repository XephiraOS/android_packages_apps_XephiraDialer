<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Ambient Crimson Glow beneath top glass rim -->
    <item>
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="32dp"
                android:topRightRadius="32dp" />
            <gradient
                android:angle="270"
                android:startColor="#3AE9012A"
                android:endColor="#00000000"
                android:type="linear" />
        </shape>
    </item>

    <!-- Frosted Obsidian Acrylic Base Plate -->
    <item android:top="2dp">
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="30dp"
                android:topRightRadius="30dp" />
            <gradient
                android:angle="270"
                android:startColor="#EE111522"
                android:endColor="#F80A0C13"
                android:type="linear" />
            <stroke
                android:width="1.5dp"
                android:color="#4DFFFFFF" />
        </shape>
    </item>
</layer-list>