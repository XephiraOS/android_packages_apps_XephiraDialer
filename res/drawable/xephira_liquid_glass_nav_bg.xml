<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer Ambient Crimson Refraction Glow -->
    <item>
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="24dp"
                android:topRightRadius="24dp" />
            <solid android:color="#18E9012A" />
        </shape>
    </item>

    <!-- Translucent Frosted White Acrylic Dock -->
    <item android:top="1.5dp">
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="23dp"
                android:topRightRadius="23dp" />
            <gradient
                android:angle="270"
                android:startColor="#F6FFFFFF"
                android:centerColor="#ECF4F6F9"
                android:endColor="#DEECEFF4"
                android:type="linear" />
            <stroke
                android:width="1.5dp"
                android:color="#FFFFFFFF" />
        </shape>
    </item>
</layer-list>
