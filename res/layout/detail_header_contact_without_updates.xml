<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout android:gravity="center_vertical" android:id="@id/controls" android:layout_width="fill_parent" android:layout_height="wrap_content" android:importantForAccessibility="no"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <RelativeLayout android:id="@id/photo_and_name_layout" android:layout_width="fill_parent" android:layout_height="wrap_content">
        <FrameLayout android:id="@id/detail_photo_container" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerHorizontal="true">
            <com.customize.contacts.widget.ColorRoundLocalImageView android:layout_gravity="center_horizontal" android:id="@id/detail_photo" android:focusable="true" android:layout_width="@dimen/color_detail_photo_size" android:layout_height="@dimen/color_detail_photo_size" android:src="@drawable/pb_ic_default_large_photo" android:scaleType="centerCrop" android:layout_centerHorizontal="true" android:contentDescription="@string/attach_photo_dialog_title" />
        </FrameLayout>
        <LinearLayout android:orientation="vertical" android:id="@id/name_layout" android:paddingTop="@dimen/DP_12" android:paddingBottom="@dimen/DP_24" android:focusable="true" android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_below="@id/detail_photo_container" android:layout_centerHorizontal="true" android:paddingStart="@dimen/DP_20" android:paddingEnd="@dimen/DP_20">
            <RelativeLayout android:id="@id/name_and_icon_layout" android:layout_width="fill_parent" android:layout_height="wrap_content">
                <TextView android:ellipsize="end" android:gravity="center_horizontal" android:id="@id/main_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerHorizontal="true" style="@style/ContactDetailLargeItemType" />
                <ImageView android:id="@id/account_icon" android:visibility="gone" android:layout_width="@dimen/DP_22" android:layout_height="@dimen/DP_22" android:layout_centerVertical="true" android:layout_marginStart="@dimen/DP_10" android:layout_toEndOf="@id/main_title" />
            </RelativeLayout>
            <TextView android:ellipsize="end" android:gravity="center_horizontal" android:id="@id/sub_title_pinyin" android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/DP_0" style="@style/SmallTextStyle" />
            <TextView android:ellipsize="end" android:gravity="center_horizontal" android:id="@id/sub_title_company" android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/DP_3" style="@style/SmallTextStyle" />
            <TextView android:ellipsize="end" android:gravity="center_horizontal" android:id="@id/sub_title_vip" android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/DP_3" style="@style/SmallTextStyle" />
        </LinearLayout>
        <include android:id="@id/detail_header_bottom_layout" layout="@layout/detail_header_bottom_layout" />
    </RelativeLayout>
</RelativeLayout>