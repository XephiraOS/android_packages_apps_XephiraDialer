<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout android:orientation="horizontal" android:layout_width="fill_parent" android:layout_height="wrap_content" android:paddingStart="@dimen/list_common_margin" android:paddingEnd="@dimen/list_common_margin" style="@style/ListItemSelectorStyle"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <RelativeLayout android:id="@id/mark_layout" android:paddingTop="@dimen/padding_top" android:paddingBottom="@dimen/padding_bottom" android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_alignParentTop="true" android:layout_centerVertical="true" android:layout_toStartOf="@id/checkbox" android:layout_alignParentStart="true">
        <LinearLayout android:layout_gravity="center_vertical" android:orientation="vertical" android:id="@id/markItem" android:layout_width="fill_parent" android:layout_height="wrap_content">
