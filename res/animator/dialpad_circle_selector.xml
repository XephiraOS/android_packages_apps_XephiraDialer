<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <set>
            <objectAnimator
                android:duration="120"
                android:interpolator="@anim/dialpad_button_down_interpolator"
                android:propertyName="scaleX"
                android:valueTo="0.92"
                android:valueType="floatType" />
            <objectAnimator
                android:duration="120"
                android:interpolator="@anim/dialpad_button_down_interpolator"
                android:propertyName="scaleY"
                android:valueTo="0.92"
                android:valueType="floatType" />
            <objectAnimator
                android:duration="120"
                android:interpolator="@anim/dialpad_button_down_interpolator"
                android:propertyName="alpha"
                android:valueFrom="0.90"
                android:valueTo="1.0"
                android:valueType="floatType" />
        </set>
    </item>
    <item android:state_pressed="false">
        <set>
            <objectAnimator
                android:duration="160"
                android:interpolator="@anim/dialpad_button_up_scale_interpolator"
                android:propertyName="scaleX"
                android:valueFrom="0.92"
                android:valueTo="1.0"
                android:valueType="floatType" />
            <objectAnimator
                android:duration="160"
                android:interpolator="@anim/dialpad_button_up_scale_interpolator"
                android:propertyName="scaleY"
                android:valueFrom="0.92"
                android:valueTo="1.0"
                android:valueType="floatType" />
            <objectAnimator
                android:duration="160"
                android:interpolator="@anim/dialpad_button_up_alpha_interpolator"
                android:propertyName="alpha"
                android:valueFrom="1.0"
                android:valueTo="0.90"
                android:valueType="floatType" />
        </set>
    </item>
</selector>