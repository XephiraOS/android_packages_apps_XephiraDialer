<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <set>
            <objectAnimator android:interpolator="@anim/dialpad_button_down_interpolator" android:duration="150" android:valueTo="0.85" android:valueType="floatType" android:propertyName="alpha" />
        </set>
    </item>
    <item android:state_activated="false">
        <set>
            <objectAnimator android:interpolator="@anim/dialpad_button_down_interpolator" android:duration="150" android:valueFrom="0.3" android:valueType="floatType" android:propertyName="alpha" />
        </set>
    </item>
</selector>