package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

android_app_import {
    name: "XephiraDialer",
    apk: "prebuilt/XephiraDialer.apk",
    certificate: "platform",
    privileged: true,
    system_ext_specific: true,
    overrides: [
        "Dialer",
        "InCallUI",
        "CarDialerApp",
    ],
}
